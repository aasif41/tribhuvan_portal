{
  "name": "tribhuvan-portal",
  "version": "1.0.0",
  "private": true,
  "description": "College management system for Tribhuvan College, Neemrana — monorepo with React web, React Native mobile, and Express backend.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:server": "npm run dev --workspace=server",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "build:shared": "npm run build --workspace=packages/shared",
    "postinstall": "npm run build:shared",
    "eas-build-pre-install": "npm run build:shared",
    "build:server": "npm run build:shared && npm run build --workspace=server",
    "build:web": "npm run build --workspace=apps/web",
    "build": "npm run build:shared && npm run build:server",
    "db:migrate": "npm run migrate --workspace=server",
    "db:seed": "npm run seed --workspace=server",
    "db:studio": "npm run studio --workspace=server",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "babel-preset-expo": "~54.0.10",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.2.5",
    "prisma": "5.14.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.8.0"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/client": "5.14.0",
    "express": "^4.19.2",
    "firebase": "^10.12.2",
    "zod": "^3.23.8"
  },
  "overrides": {
    "@tribhuvan/web": {
      "@types/react": "^18.3.31",
      "@types/react-dom": "^18.3.7"
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.4",
    "@rollup/rollup-linux-x64-musl": "4.62.4"
  }
}
