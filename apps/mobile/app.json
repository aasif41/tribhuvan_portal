{
  "expo": {
    "name": "Tribhuvan College",
    "slug": "tribhuvan-college",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tribhuvan",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0d1f3c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ac.in.tribhuvancollege.portal"
    },
    "android": {
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0d1f3c"
      },
      "package": "ac.in.tribhuvancollege.portal"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "appRoot": "./app"
      },
      "eas": {
        "projectId": "3474d09b-37ee-4e96-8b6b-2135c25235c3"
      }
    },
    "owner": "aasif45"
  }
}
